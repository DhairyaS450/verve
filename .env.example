# ---- Gemini (server only) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Firebase web config (public; un-prefixed names also accepted) ----
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ---- Google OAuth (Drive + sign-in). Web client from GCP console ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 32 random bytes, base64. Encrypts Drive refresh tokens at rest ----
TOKEN_ENC_KEY=

# ---- Public URL of the deployment (no trailing slash) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
